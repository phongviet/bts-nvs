# Data — never commit, always regenerable from organizers' archive or data/raw/
data/raw/
data/processed/

# Run artifacts — heavy binaries gitignored; small configs/metrics/logs kept
runs/*/**/nerfstudio_models/
runs/*/**/checkpoints/
runs/*/**/renders_val/
runs/*/**/renders_test/
runs/*/**/logs/tensorboard/
runs/**/*.ckpt
runs/**/events.out.tfevents.*

# Submissions (zips are large; keep SUBMISSION_LOG.md only)
submissions/**/*.zip

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/

# OS cruft from macOS-zipped archives
.DS_Store
__MACOSX/

# Env
*.env

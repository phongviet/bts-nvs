# Data — never commit, always regenerable from organizers' archive or data/raw/
data/raw/
data/processed/

# Run artifacts — heavy binaries gitignored; small configs/metrics/logs kept
runs/*/**/nerfstudio_models/
runs/*/**/checkpoints/
runs/**/renders*/
runs/*/**/logs/tensorboard/
runs/**/*.ckpt
runs/**/events.out.tfevents.*

# Submissions (zips are large; keep SUBMISSION_LOG.md only)
submissions/**/*.zip

# Analysis — keep scripts/reports/CSVs; heavy render/output dirs are regenerable
Analysis/X1_nearest_copy/
Analysis/X3_dibr/
Analysis/X4_distortion_remap/
Analysis/X5_refiner/
Analysis/X6_jpeg_budget/
Analysis/**/*.log

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# OS cruft from macOS-zipped archives
.DS_Store
__MACOSX/

# WSL / Windows metadata sidecars
*:Zone.Identifier

# Env
*.env

# Unzipped submission staging/results dirs (renders are heavy; zips already ignored)
submissions/phase1/*_results/
submissions/phase1/exp001_results/

# External clones (VGGT etc.) -- pinned by commit hash in docs, not vendored
third_party/

# transient wave-orchestrator state
results/local_wave_jul17/*.done
results/local_wave_jul17_queue.log

# ---- sss_experiment (moved in from repo root 2026-07-28) ----
